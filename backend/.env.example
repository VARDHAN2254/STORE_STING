# STORE STING Backend Environment Configuration
PROJECT_NAME="STORE STING"
TAGLINE="Shopping, reimagined."
ENVIRONMENT=development
DEBUG=true

# Database (Neon PostgreSQL connection string)
# Format: postgresql+asyncpg://[user]:[password]@[endpoint].neon.tech/[dbname]?ssl=require
DATABASE_URL=

# Security
SECRET_KEY=change-this-in-production-to-a-secure-random-token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Worker Configuration
WORKER_ID=worker-main-01
WORKER_POLL_INTERVAL_SEC=1.0
MAX_RETRY_ATTEMPTS=3

# Production CORS Origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","https://store-sting.netlify.app"]
