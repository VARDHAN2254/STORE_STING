# ============================================================
# STORE STING — Backend Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit the real .env file to version control.
# ============================================================

# Project
PROJECT_NAME="STORE STING"
TAGLINE="Shopping, reimagined."
ENVIRONMENT=development
DEBUG=true

# ---------- Database (Neon PostgreSQL) ----------
# Pooled connection string (recommended for application traffic):
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=

# Direct (unpooled) connection string (for migrations / admin):
DATABASE_URL_UNPOOLED=

# Neon branch name (set automatically by `neon link` / `neon env pull`):
NEON_BRANCH=

# ---------- Security ----------
# Generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-in-production-to-a-secure-random-token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------- Worker ----------
WORKER_ID=worker-main-01
WORKER_POLL_INTERVAL_SEC=1.0
MAX_RETRY_ATTEMPTS=3

# ---------- CORS ----------
# Comma-separated or JSON list of allowed frontend origins.
# In production, restrict to your actual deployment domain(s).
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
