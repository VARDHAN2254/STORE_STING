# ========================================
# STORE STING — .gitignore
# ========================================

# ---------- Environment / Secrets ----------
.env
.env.*
!.env.example
.env.local

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.installed.cfg
.venv/
venv/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------- Node ----------
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---------- Build output ----------
dist/
build/
frontend/dist/

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
[Dd]esktop.ini

# ---------- Logs ----------
*.log

# ---------- Local databases / runtime ----------
*.db
*.sqlite
*.sqlite3

# ---------- Secrets / certificates ----------
*.pem
*.key
*.crt
*.p12
*.pfx

# ---------- Local Neon context ----------
# Contains project/org/branch IDs specific to the developer's local linkage.
# Regenerate with: neon link --project-id <id> --branch <branch> -y
.neon

# ---------- Neon env pulled files ----------
.env.local

# ---------- TypeScript build cache ----------
frontend/tsconfig.tsbuildinfo

# ---------- Reference archive ----------
_reference/

# ---------- Neon skills lock (auto-generated) ----------
# skills-lock.json is auto-generated by `neon skills`
# Kept tracked intentionally for reproducibility.
